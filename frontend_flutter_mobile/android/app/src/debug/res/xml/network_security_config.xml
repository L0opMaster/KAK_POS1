<?xml version="1.0" encoding="utf-8"?>
<!--
  Flagged (but deliberately deferred) in DAY_02_MOBILE_PROJECT_CONFIGURATION.md:
  AppConfig.baseUrl resolves to plain http:// for every platform branch
  (localhost:8081 / 10.0.2.2 emulator alias / a real-device LAN IP), and
  Android 9+ (API 28+) blocks cleartext (non-HTTPS) traffic by default —
  every login/API call on a real device or emulator fails with a generic
  connection error until this is added.

  CORRECTED (Day 20 — crash found via `flutter run` on a physical device,
  not caught by `flutter analyze`/`flutter build`, which don't validate
  this XML against Android's actual network-security-config schema): the
  previous version of this file nested a <domain-config> INSIDE
  <debug-overrides>, which Android's parser rejects outright —
  <debug-overrides> only ever accepts a <trust-anchors> child, never a
  <domain-config> — crashing with "Nested domain-config not allowed in
  debug-overrides" the instant the Application object is created, before
  a single frame of the app could render.

  The fix isn't a smaller edit to that same structure — <debug-overrides>
  fundamentally cannot carry a domain-specific cleartext exception, full
  stop. The correct Android mechanism for "cleartext allowed for these
  hosts, but only in debug builds, automatically absent from release" is
  Gradle's own resource source-set overlay: this file lives ONLY under
  `src/debug/res/xml/`, so it's included in debug builds and silently
  absent from release ones, where
  `android/app/src/main/res/xml/network_security_config.xml` (the
  same-named file in the `main` source set, which release builds DO see)
  applies instead — a minimal, strict, no-cleartext default. `debug` and
  `main` never merge for the same resource name; the build-type-specific
  one wins outright for its variant. No <debug-overrides> element is
  needed here at all once the file itself is debug-only.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- AppConfig.baseUrl's three dev-backend hosts (app_config.dart). -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.1.13</domain>
    </domain-config>
</network-security-config>
